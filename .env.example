# =============================================================================
# SYNCLEDGER - ENVIRONMENT VARIABLES
# Copy this file to .env and configure your settings
# DO NOT commit .env file to version control!
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# For local dev: uses docker Postgres (localhost:5432)
# For deployment: set DB_HOST to RDS endpoint
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=syncledger
DB_USERNAME=syncledger
DB_PASSWORD=syncledger123

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# Generate a secure secret: openssl rand -base64 64
JWT_SECRET=syncledger-dev-jwt-secret-key-min-256-bits-long

# =============================================================================
# MICROSOFT AZURE AD / OUTLOOK CONFIGURATION
# Required for email polling from organization mailboxes
# =============================================================================
# Setup instructions:
# 1. Go to Azure Portal > Azure Active Directory > App registrations
# 2. New registration > Name: SyncLedger > Single tenant
# 3. Add API permissions: Microsoft Graph > Application permissions:
#    - Mail.Read (Read mail in all mailboxes)
#    - Mail.ReadWrite (for marking as read)
# 4. Grant admin consent
# 5. Create client secret (copy immediately - only shown once)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# =============================================================================
# EMAIL POLLING CONFIGURATION
# =============================================================================
# Set to true when Azure credentials are configured
EMAIL_POLLING_ENABLED=false
# Polling interval in milliseconds (default: 5 minutes)
EMAIL_POLLING_INTERVAL_MS=300000

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
# Options: local (default - for development) or s3 (for production)
STORAGE_TYPE=local
# Local storage path (when STORAGE_TYPE=local)
STORAGE_LOCAL_BASE_PATH=./uploads

# =============================================================================
# AWS CONFIGURATION (S3 and SQS)
# =============================================================================
# Required only when STORAGE_TYPE=s3
# For local development with LocalStack, use test/test
# For production, use real AWS IAM credentials
AWS_ACCESS_KEY=test
AWS_SECRET_KEY=test
AWS_REGION=us-east-1
S3_BUCKET_NAME=syncledger-invoices

# =============================================================================
# SAGE INTACCT API (XML Web Services)
# =============================================================================
# Sage Intacct uses XML API with TWO-LAYER authentication:
#   Layer 1 — Sender credentials (application-level): identifies your app
#   Layer 2 — Login credentials (per-org): identifies the user + company
#
# GLOBAL SENDER CREDENTIALS (optional — can also be set per-org in admin panel):
# Get these by registering at https://developer.intacct.com
SAGE_SENDER_ID=
SAGE_SENDER_PASSWORD=
# Legacy REST API URL (not used for Intacct — Intacct uses XML gateway)
SAGE_API_URL=https://api.sage.com

# =============================================================================
# PDF MICROSERVICE
# =============================================================================
PDF_SERVICE_URL=http://localhost:8001

# =============================================================================
# OPENAI API KEY (GPT-4o for AI invoice extraction)
# =============================================================================
# Required: Set your OpenAI API key to enable the 3-tier AI extraction engine
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# AI model selection (defaults are gpt-4o)
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4o

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
API_URL=http://localhost:8080/api

# =============================================================================
# ORGANIZATION SEED — LONGHOME (first customer)
# =============================================================================
# These seed the initial organization on first startup.
# Set SEED_LONGHOME_ENABLED=false to skip seeding.
SEED_LONGHOME_ENABLED=true
SEED_LONGHOME_MS_CLIENT_ID=
SEED_LONGHOME_MS_TENANT_ID=
SEED_LONGHOME_MS_CLIENT_SECRET=
SEED_LONGHOME_MS_MAILBOX=admin@evolotek.ai
# Sage Intacct login credentials (per-org):
SEED_LONGHOME_ERP_COMPANY_ID=
SEED_LONGHOME_ERP_USER_ID=
SEED_LONGHOME_ERP_PASSWORD=
# Sage Intacct sender credentials (application-level — optional if SAGE_SENDER_ID is set globally):
SEED_LONGHOME_ERP_SENDER_ID=
SEED_LONGHOME_ERP_SENDER_PASSWORD=
SEED_LONGHOME_ADMIN_PASSWORD=LongHome@2026!
